# VerityMem local configuration.
# Copy to .env. Defaults match deploy/compose/docker-compose.yml.

# Canonical store. The server connects as the RLS-bound application role.
DATABASE_URL=postgres://veritymem_app:veritymem_app@127.0.0.1:55432/veritymem
# Migrations run as the owner/superuser, which may create roles, policies and extensions.
MIGRATION_DATABASE_URL=postgres://verity:verity@127.0.0.1:55432/veritymem

# Content-addressed blob storage for large evidence payloads.
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=verity
S3_SECRET_ACCESS_KEY=veritysecret
S3_BUCKET=veritymem-blobs

# Inline payloads at or below this many bytes stay in the ledger row.
LEDGER_INLINE_PAYLOAD_LIMIT=8192

# HTTP listener. Admin routes require a separate credential (see ADMIN_TOKEN).
PORT=8787
HOST=127.0.0.1

# Audience separation: an agent token must never reach /v1/grants or /v1/forget.
# Both are opaque bearer tokens in v0.1; capability tokens carry scope and purpose.
AGENT_TOKEN=dev-agent-token
ADMIN_TOKEN=dev-admin-token

# Extraction model adapter. Optional: with no key the pipeline degrades to
# deterministic extractors only and records that fact in the decision trace.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=

# Entailment gate. onnx = in-process quantised DeBERTa-v3 MNLI; lexical = deterministic
# offline stand-in used in tests and CI, and recorded explicitly in projection_versions
# so a gate swap is never silent.
GATE_ENTAILMENT_BACKEND=lexical
GATE_MODEL_PATH=
GATE_MODEL_SHA256=
GATE_CONFIDENCE_THRESHOLD=0.5

# Embedding projection for the dense retrieval channel.
EMBEDDING_BACKEND=hash
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL_ID=hash-ngram-v1

# Retention policy for /v1/forget.
RETENTION_LEDGER_MODE=redact
